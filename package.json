{
  "name": "ai-stocks-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native investment research platform for public companies.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate-seed": "tsx scripts/generate-supabase-seed.ts",
    "db:apply-local": "npm run db:generate-seed && supabase db reset",
    "db:apply-remote": "npm run db:generate-seed && supabase db push --linked --include-seed",
    "db:lint": "supabase db lint --local",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:verify-remote": "tsx scripts/verify-supabase-seed.ts",
    "ai:generate": "tsx --conditions=react-server scripts/generate-ai-research.ts",
    "ai:review": "tsx --conditions=react-server scripts/review-ai-research.ts",
    "ai:verify": "tsx scripts/verify-ai-services.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "openai": "^4.80.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.4.49",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
